    "hisCurve": {
        "icon": "<i class=\"fa-solid fa-chart-line\"></i>",
        "comment": "今日曲线卡片",
        "(011|123).*": {
            "cmd": "GCurve -app_key_id realtime:1:scada:1/${TAB_NO}:${DEV_NO}0021/0 -IP ${HOST} -sessionID '${SESSION_ID}'",
            "comment": "今日曲线",
            "pos": {
                "w": 1200,
                "h": 800
            }
        },
        ".*": {
            "cmd": "GCurve -app_key_id realtime:1:scada:1/${TAB_NO}:${DEV_NO}${COL_NO}/0 -IP ${HOST} -sessionID '${SESSION_ID}'",
            "comment": "今日曲线",
            "pos": {
